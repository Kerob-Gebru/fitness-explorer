# Copy this file to ".env.local" and edit the copy. NEVER put real keys in this file.
# Variables starting with VITE_ are bundled into the browser build and are visible
# to anyone who opens the site. They are NOT secret.

# true  = use built-in demo data (no API key needed). This is the default.
# false = try the live ExerciseDB service (not verified yet, see README).
VITE_USE_MOCK_DATA=true

# Demo mode only: set to true to see how the app looks when a request fails.
VITE_MOCK_SIMULATE_ERROR=false

# Live mode only (placeholders, fill in after verifying on RapidAPI):
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_HOST=your_exercisedb_host_here
VITE_RAPIDAPI_BASE_URL=https://your_exercisedb_host_here
